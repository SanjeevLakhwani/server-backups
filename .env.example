# Copy to .env (chmod 600). Read by backup.sh and the justfile.

# ── Restic repository on IDrive e2 (Chicago) ─────────────────────────────────
RESTIC_REPOSITORY=s3:https://s3.us-midwest-1.idrivee2.com/sanjeev-server-backups
AWS_DEFAULT_REGION=us-midwest-1
# Access key limited to the sanjeev-server-backups bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# File holding the restic password (one line, chmod 600). Relative paths are
# resolved from this repo's folder. Also keep it in your
# password manager: without it the backups can't be decrypted.
RESTIC_PASSWORD_FILE=./restic-password

# ── What to back up ──────────────────────────────────────────────────────────
BASE_WEBSITE_DIR=/deploy
# Where base-website's `just backup` writes postgres.sql.gz + photos/
STAGING_DIR=/deploy/backups/latest
PAPERLESS_DIR=/home/san/docker/paperless
EDGE_PROXY_DIR=/home/san/docker/proxy

# Fail the run if base-website reports a SKIPPED step (e.g. postgres or garage
# not running). Leave true in production so a stopped container can't silently
# produce empty backups.
FAIL_ON_SKIP=true

# ── Retention ────────────────────────────────────────────────────────────────
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=12

# ── Monitoring (optional) ────────────────────────────────────────────────────
# healthchecks.io ping URL, e.g. https://hc-ping.com/<uuid>. Gets /start, success
# and /fail (with the end of the log) so a broken or missed night emails you.
HC_PING_URL=
